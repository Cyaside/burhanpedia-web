# Example environment variables for Burhanpedia frontend
# Copy this file to .env.local and fill with real values

# Browser calls this same-origin path; Next.js proxies it to the backend.
NEXT_PUBLIC_API_URL=/api/v1
BACKEND_ORIGIN=http://127.0.0.1:3000

# Must match backend S3_PUBLIC_BASE_URL so next/image can load catalog images.
IMAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000/burhanpedia-images
