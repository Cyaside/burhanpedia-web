# Example environment variables for Burhanpedia backend
# Copy this file to .env and fill with real values (do NOT commit secrets)

# PostgreSQL connection string (Prisma uses this)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/burhanpedia_db

# Supabase example (pooler/pgbouncer, serverless-friendly):
# DATABASE_URL="postgresql://postgres.<ref>:[PASSWORD]@aws-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# Optional: direct DB connection for migrations (recommended).
# Prisma CLI will prefer this over DATABASE_URL when set (see `prisma.config.ts`).
PRISMA_MIGRATE_DATABASE_URL=postgresql://user:password@localhost:5432/burhanpedia_db

# Supabase example (direct DB, for migrations):
# PRISMA_MIGRATE_DATABASE_URL="postgresql://postgres.<ref>:[PASSWORD]@db.<ref>.supabase.co:5432/postgres?sslmode=require"

# Supabase (Storage) - required for image upload
# Use either NEXT_PUBLIC_SUPABASE_URL or SUPABASE_URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=
# Use the service role key for server-side uploads
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT for authentication (change before production)
JWT_SECRET=your-very-strong-jwt-secret
JWT_EXPIRES_IN=24h

# Server / runtime
PORT=3000
NODE_ENV=development

# Optional: primary frontend URL (single origin)
FRONTEND_URL=http://localhost:3001

# Optional: additional CORS origins (CSV)
# Example: http://localhost:5173,http://localhost:3001
ADDITIONAL_ORIGINS=
