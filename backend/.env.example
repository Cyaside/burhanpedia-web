# Example environment variables for Burhanpedia backend
# Copy this file to .env and fill with real values (do NOT commit secrets)

# PostgreSQL
DATABASE_URL=postgresql://burhanpedia:burhanpedia_dev@localhost:5432/burhanpedia
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_SSL_REJECT_UNAUTHORIZED=false
LOG_SLOW_REQUEST_MS=750

# S3-compatible image storage (optional for API startup in development)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=burhanpedia-images
S3_ACCESS_KEY_ID=burhanpedia_dev
S3_SECRET_ACCESS_KEY=burhanpedia_dev_secret
S3_PUBLIC_BASE_URL=http://127.0.0.1:9000/burhanpedia-images

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Server / runtime
PORT=3000
NODE_ENV=development

# Optional: primary frontend URL (single origin)
FRONTEND_URL=http://localhost:3001

# Optional: additional CORS origins (CSV)
# Example: http://localhost:5173,http://localhost:3001
ADDITIONAL_ORIGINS=
