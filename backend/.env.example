# Example environment variables for Burhanpedia backend
# Copy this file to .env and fill with real values (do NOT commit secrets)

# PostgreSQL
DATABASE_URL=postgresql://burhanpedia:burhanpedia_dev@localhost:5432/burhanpedia
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=10000
DATABASE_SSL_REJECT_UNAUTHORIZED=false

# Supabase (Storage) - required for image upload
# Use either NEXT_PUBLIC_SUPABASE_URL or SUPABASE_URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=
# Use the service role key for server-side uploads
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Authentication
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# Server / runtime
PORT=3000
NODE_ENV=development

# Optional: primary frontend URL (single origin)
FRONTEND_URL=http://localhost:3001

# Optional: additional CORS origins (CSV)
# Example: http://localhost:5173,http://localhost:3001
ADDITIONAL_ORIGINS=
